{% comment %}
  Renders luxury product card with secondary image hover, badges, star ratings, price, and view options button
  Accepts:
  - product: {Object} Shopify Product object
{% endcomment %}

{% assign card_url = product.url | default: '/collections/all' %}

<div class="product-card">
  <div class="product-card-image-wrapper">
    <a href="{{ card_url }}">
      {% if product.featured_media %}
        <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | default: product.title | escape }}" loading="lazy" class="product-card-image-primary">
        {% if product.media[1] %}
          <img src="{{ product.media[1] | image_url: width: 600 }}" alt="{{ product.media[1].alt | default: product.title | escape }}" loading="lazy" class="product-card-image-secondary">
        {% endif %}
      {% else %}
        <div class="demo-card-illustration" style="background-color: #f7f2ec;">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </a>

    <div class="product-card-badges">
      {% if product.compare_at_price > product.price %}
        <span class="badge badge-sale">Sale</span>
      {% endif %}
      {% if product.tags contains 'bestseller' or product.tags contains 'best seller' or product.tags contains 'Best Seller' %}
        <span class="badge badge-bestseller">Bestseller</span>
      {% endif %}
    </div>
  </div>

  <div class="product-card-content">
    {% if product.vendor != blank %}
      <div class="product-card-vendor">{{ product.vendor | uppercase }}</div>
    {% endif %}

    <h3 class="product-card-title">
      <a href="{{ card_url }}">{{ product.title | default: "Featured Product" }}</a>
    </h3>

    <div class="star-rating" style="font-size: 0.8rem; margin-bottom: 6px;">
      {% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}
      <span class="rating-text">4.9</span>
    </div>

    <div class="product-card-price-row">
      {% render 'price', product: product %}
    </div>

    <a href="{{ card_url }}" class="btn btn-secondary btn-pill-small btn-full" style="margin-top: auto;">
      {% if product.has_only_default_variant %}
        {{ 'general.product.view_options' | t | default: 'View Product' }}
      {% else %}
        {{ 'general.product.view_options' | t | default: 'View Options' }}
      {% endif %}
    </a>
  </div>
</div>
