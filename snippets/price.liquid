{% comment %}
  Renders product price formatting with compare at price & sale indicator
{% endcomment %}

<div class="price-container" style="display: inline-flex; align-items: center; gap: 8px;">
  {% if product.price_varies %}
    <span class="price">From {{ product.price_min | money }}</span>
  {% else %}
    <span class="price">{{ product.price | money }}</span>
  {% endif %}

  <span class="compare-at-price" style="{% unless product.compare_at_price > product.price %}display: none;{% endunless %}">{{ product.compare_at_price | money }}</span>
  {% assign discount = 0 %}
  {% if product.compare_at_price > product.price %}
    {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
  {% endif %}
  <span class="price-discount-badge" style="font-size: 0.78rem; font-weight: 700; color: var(--color-primary); {% unless product.compare_at_price > product.price %}display: none;{% endunless %}">Save {{ discount }}%</span>
</div>
