<div class="press-logos-section">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div style="text-align: center; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 24px;">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    <div class="press-logos-grid">
      {% for block in section.blocks %}
        {% if block.settings.logo_image != blank %}
          <img src="{{ block.settings.logo_image | image_url: width: 240 }}" alt="{{ block.settings.press_title | escape }}" style="max-height: 28px; width: auto;" {{ block.shopify_attributes }}>
        {% else %}
          <span class="press-logo-text" {{ block.shopify_attributes }}>{{ block.settings.press_title }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Press & Feature Logos",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "AS FEATURED IN"
    }
  ],
  "blocks": [
    {
      "type": "press_logo",
      "name": "Press Outlet",
      "settings": [
        {
          "type": "text",
          "id": "press_title",
          "label": "Publication Name",
          "default": "VOGUE"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press & Feature Logos",
      "blocks": [
        { "type": "press_logo", "settings": { "press_title": "VOGUE" } },
        { "type": "press_logo", "settings": { "press_title": "ELLE" } },
        { "type": "press_logo", "settings": { "press_title": "GQ" } },
        { "type": "press_logo", "settings": { "press_title": "BAZAAR" } },
        { "type": "press_logo", "settings": { "press_title": "FORBES" } }
      ]
    }
  ]
}
{% endschema %}
