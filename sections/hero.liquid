<div class="hero-section" style="{% if section.settings.image != blank %}background-image: url('{{ section.settings.image | image_url: width: 2000 }}');{% else %}background: linear-gradient(135deg, var(--color-card-bg) 0%, var(--color-secondary) 100%);{% endif %}">
  <div class="hero-overlay"></div>
  
  <div class="page-width" style="width: 100%;">
    <div class="hero-card">
      
      {% if section.settings.show_rating %}
        <div class="hero-subtitle">
          <div class="star-rating">
            {% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}
          </div>
          <span class="rating-text">{{ section.settings.rating_text }}</span>
        </div>
      {% endif %}

      <h1 class="hero-title">{{ section.settings.heading }}</h1>
      <p class="hero-description">{{ section.settings.subheading }}</p>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn-primary">
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Background Image"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text Label",
      "default": "Rated by Store Customers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Store Headline Announcement"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a descriptive message introducing your store's featured collection or products."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
