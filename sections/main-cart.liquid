<div class="main-cart-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: var(--color-bg);">
  <div class="page-width">
    
    <h1 style="margin-bottom: 36px; text-align: center; font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3rem);">{{ 'general.cart.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        
        <div class="cart-page-layout" style="display: grid; grid-template-columns: 1fr 380px; gap: 40px; align-items: flex-start;">
          
          <!-- Left Cart Items Column -->
          <div class="cart-items-wrapper" style="display: flex; flex-direction: column; gap: 20px;">
            {% for item in cart.items %}
              <div class="cart-item-row" style="display: grid; grid-template-columns: 90px 1fr auto; gap: 20px; align-items: center; border-bottom: 1px solid var(--color-border); padding-bottom: 20px;">
                
                <a href="{{ item.url }}" style="display: block;">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" style="width: 90px; height: 90px; object-fit: contain; background: #ffffff; border-radius: 8px; border: 1px solid var(--color-border); padding: 4px;">
                  {% else %}
                    <div style="width: 90px; height: 90px; background: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; color: #888;">Item</div>
                  {% endif %}
                </a>
                
                <div>
                  <h3 style="font-size: 1.05rem; font-family: var(--font-heading); font-weight: 600; margin-bottom: 4px;">
                    <a href="{{ item.url }}" style="color: var(--color-heading); text-decoration: none;">{{ item.product.title }}</a>
                  </h3>
                  {% unless item.has_only_default_variant %}
                    <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 6px;">{{ item.variant.title }}</p>
                  {% endunless %}
                  <div style="font-size: 0.95rem; font-weight: 700; color: var(--color-heading); margin-bottom: 8px;">{{ item.final_price | money }}</div>
                  
                  <a href="{{ item.url_to_remove }}" style="font-size: 0.8rem; color: var(--color-primary); text-decoration: underline; display: inline-block;">Remove Item</a>
                </div>

                <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 8px;">
                  <div style="font-weight: 700; font-size: 1.1rem; color: var(--color-heading);">{{ item.final_line_price | money }}</div>
                  
                  <div class="quantity-controls" style="display: inline-flex; border: 1px solid var(--color-border); border-radius: 4px; overflow: hidden; background: #ffffff;">
                    <button type="button" class="qty-btn" onclick="this.parentNode.querySelector('input').stepDown(); this.form.submit();" style="width: 32px; height: 32px; border: none; background: none; cursor: pointer; font-weight: 700;">-</button>
                    <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" style="width: 44px; height: 32px; padding: 0; text-align: center; border: none; font-weight: 600; font-size: 0.9rem;">
                    <button type="button" class="qty-btn" onclick="this.parentNode.querySelector('input').stepUp(); this.form.submit();" style="width: 32px; height: 32px; border: none; background: none; cursor: pointer; font-weight: 700;">+</button>
                  </div>
                </div>

              </div>
            {% endfor %}

            {% if section.settings.show_cart_note %}
              <div style="margin-top: 16px;">
                <label for="CartSpecialInstructions" style="display: block; font-weight: 700; font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">Order Special Instructions / Notes:</label>
                <textarea name="note" id="CartSpecialInstructions" rows="3" placeholder="Add any special delivery instructions..." style="width: 100%; padding: 12px; border-radius: var(--border-radius-sm); border: 1.5px solid var(--color-border); font-family: var(--font-body); font-size: 0.9rem; background: #ffffff;">{{ cart.note }}</textarea>
              </div>
            {% endif %}

          </div>

          <!-- Right Subtotal Summary Box -->
          <div style="background-color: var(--color-card-bg); padding: 32px 28px; border-radius: var(--border-radius-card); border: 1px solid var(--color-border); position: sticky; top: 100px;">
            <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--color-border);">Order Summary</h3>
            
            <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.2rem; margin-bottom: 12px; color: var(--color-heading);">
              <span>{{ 'general.cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            
            <p style="font-size: 0.85rem; color: var(--color-text-muted); margin-bottom: 24px; line-height: 1.4;">{{ 'general.cart.shipping_at_checkout' | t }}</p>

            <button type="submit" name="checkout" class="btn btn-primary btn-full" style="padding: 16px; font-size: 1rem; font-weight: 700; width: 100%; cursor: pointer;">
              {{ 'general.cart.checkout' | t }} &rarr;
            </button>
            
            <div style="margin-top: 20px; text-align: center; font-size: 0.8rem; color: var(--color-text-muted); display: flex; align-items: center; justify-content: center; gap: 6px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              <span>100% Encrypted &amp; Secure Checkout</span>
            </div>
          </div>

        </div>

      </form>
    {% else %}
      <!-- Empty Cart State -->
      <div class="text-center" style="padding: 60px 20px; max-width: 500px; margin: 0 auto; background: var(--color-card-bg); border-radius: var(--border-radius-card); border: 1px solid var(--color-border);">
        <div style="width: 64px; height: 64px; border-radius: 50%; background: #f7eff2; color: #b05d76; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
        <h2 style="font-family: var(--font-heading); font-size: 1.6rem; margin-bottom: 8px;">Your Shopping Cart is Empty</h2>
        <p style="font-size: 0.95rem; color: var(--color-text-muted); margin-bottom: 28px; line-height: 1.5;">Explore our most popular collections and discover your new favorites today.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary hero-pill-btn" style="padding: 14px 32px;">
          {{ 'general.cart.continue_shopping' | t }} &rarr;
        </a>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Cart Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show Special Instructions Note",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ]
}
{% endschema %}
