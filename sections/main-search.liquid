<div style="padding: 80px 0; background-color: var(--color-bg);">
  <div class="page-width">
    
    <div class="text-center" style="margin-bottom: 48px; max-width: 600px; margin-left: auto; margin-right: auto;">
      <h1 style="margin-bottom: 16px;">Search Products</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 10px; margin-bottom: 16px;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search Beauty, Food, Fragrance..." style="flex-grow: 1; padding: 14px 20px; border-radius: var(--border-radius-pill); border: 1.5px solid var(--color-border); font-size: 1rem; background: var(--color-bg);" autofocus>
        <button type="submit" class="btn btn-primary">Search</button>
      </form>

      {% if search.performed %}
        <p style="color: var(--color-text-muted); margin-top: 8px;">
          Showing {{ search.results_count }} results for "{{ search.terms | escape }}"
        </p>
      {% endif %}
    </div>

    {% if search.performed and search.results_count > 0 %}
      <div class="product-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% render 'product-card', product: item %}
          {% endif %}
        {% endfor %}
      </div>
    {% elsif search.performed %}
      <div class="text-center" style="padding: 40px 0;">
        <p style="color: var(--color-text-muted);">{{ 'general.search.no_results' | t }}</p>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Search Results Page",
  "settings": []
}
{% endschema %}
