<div style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: var(--color-bg);">
  <div class="page-width" style="max-width: 800px;">
    <h1 style="margin-bottom: 24px; text-align: center;">{{ page.title }}</h1>
    <div style="line-height: 1.8; color: var(--color-text);">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Standard Page",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    }
  ]
}
{% endschema %}
