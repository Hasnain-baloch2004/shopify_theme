<footer class="site-footer" style="background-color: {{ section.settings.bg_color | default: 'var(--color-primary)' }}; color: {{ section.settings.text_color | default: '#ffffff' }};">
  <div class="page-width">
    
    <div class="footer-grid">
      
      <!-- Newsletter Column -->
      {% if section.settings.show_newsletter %}
        <div class="footer-newsletter-col">
          <h3 class="footer-heading" style="color: {{ section.settings.heading_color | default: '#ffffff' }};">{{ section.settings.newsletter_title }}</h3>
          <p class="footer-subtext">{{ section.settings.newsletter_text }}</p>
          
          {% form 'customer', class: 'footer-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            
            {% if form.posted_successfully? %}
              <div class="newsletter-success-msg">
                ✓ Thank you for subscribing! Check your inbox soon.
              </div>
            {% else %}
              {% if form.errors %}
                <div class="newsletter-error-msg">
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </div>
              {% endif %}

              <div class="newsletter-input-group">
                <input type="email" name="contact[email]" placeholder="Enter your email address" aria-label="Email address" required class="footer-input">
                <button type="submit" class="btn footer-submit-btn">
                  Subscribe
                </button>
              </div>
            {% endif %}
          {% endform %}

          <!-- Social Links -->
          {% if section.settings.show_social %}
            <div class="footer-social-links">
              {% if settings.social_instagram != blank %}
                <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
              {% endif %}
              {% if settings.social_facebook != blank %}
                <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.5 5H18V0h-3.808C10.592 0 9 1.583 9 4.615V8z"/></svg>
                </a>
              {% endif %}
              {% if settings.social_twitter != blank %}
                <a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" aria-label="Twitter / X">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              {% endif %}
              {% if settings.social_youtube != blank %}
                <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              {% endif %}
              {% if settings.social_pinterest != blank %}
                <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 11.985-5.365 11.985-11.987C23.97 5.367 18.62 0 12.017 0z"/></svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}

      <!-- Footer Menu 1 -->
      <div class="footer-col footer-col-menu">
        <button type="button" class="footer-accordion-header" data-action="toggle-footer-menu" aria-label="Toggle Shop Menu">
          <h4 class="footer-heading" style="color: {{ section.settings.heading_color | default: '#ffffff' }};">{{ section.settings.menu_1_title | default: 'Shop' }}</h4>
          <span class="footer-accordion-icon">{% render 'icon-chevron' %}</span>
        </button>
        <div class="footer-menu-content">
          {% assign menu_1 = section.settings.menu_1 %}
          {% if menu_1.links == blank %}{% assign menu_1 = linklists[section.settings.menu_1] %}{% endif %}
          <ul class="footer-menu-list">
            {% if menu_1.links != blank %}
              {% for link in menu_1.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/all">All Collections</a></li>
              <li><a href="/collections">Featured Products</a></li>
              <li><a href="/products">Best Sellers</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Footer Menu 2 -->
      <div class="footer-col footer-col-menu">
        <button type="button" class="footer-accordion-header" data-action="toggle-footer-menu" aria-label="Toggle Help Menu">
          <h4 class="footer-heading" style="color: {{ section.settings.heading_color | default: '#ffffff' }};">{{ section.settings.menu_2_title | default: 'Help' }}</h4>
          <span class="footer-accordion-icon">{% render 'icon-chevron' %}</span>
        </button>
        <div class="footer-menu-content">
          {% assign menu_2 = section.settings.menu_2 %}
          {% if menu_2.links == blank %}{% assign menu_2 = linklists[section.settings.menu_2] %}{% endif %}
          <ul class="footer-menu-list">
            {% if menu_2.links != blank %}
              {% for link in menu_2.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/contact">Contact Us</a></li>
              <li><a href="/pages/faq">Shipping & Delivery</a></li>
              <li><a href="/pages/returns">Returns & Exchange</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Footer Menu 3 -->
      <div class="footer-col footer-col-menu">
        <button type="button" class="footer-accordion-header" data-action="toggle-footer-menu" aria-label="Toggle About Menu">
          <h4 class="footer-heading" style="color: {{ section.settings.heading_color | default: '#ffffff' }};">{{ section.settings.menu_3_title | default: 'About' }}</h4>
          <span class="footer-accordion-icon">{% render 'icon-chevron' %}</span>
        </button>
        <div class="footer-menu-content">
          {% assign menu_3 = section.settings.menu_3 %}
          {% if menu_3.links == blank %}{% assign menu_3 = linklists[section.settings.menu_3] %}{% endif %}
          <ul class="footer-menu-list">
            {% if menu_3.links != blank %}
              {% for link in menu_3.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/about">Our Brand Story</a></li>
              <li><a href="/pages/quality">Quality Guarantee</a></li>
              <li><a href="/pages/sustainability">Sustainability</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

    </div>

    <!-- Giant Watermark Logo -->
    {% if section.settings.show_watermark %}
      <div class="footer-watermark">
        {{ section.settings.watermark_text | default: shop.name | default: 'JovarkusSalesCo' }}
      </div>
    {% endif %}

    <!-- Footer Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: shop.name | default: 'JovarkusSalesCo' }}. All Rights Reserved. Powered by Shopify.
      </div>
      
      {% if section.settings.show_payment_icons %}
        <div class="footer-payment-icons">
          {% assign enabled_payment_types = shop.enabled_payment_types %}
          {% if enabled_payment_types.size > 0 %}
            {% for type in enabled_payment_types %}
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            {% endfor %}
          {% else %}
            <span class="payment-badge">Visa</span>
            <span class="payment-badge">Mastercard</span>
            <span class="payment-badge">Amex</span>
            <span class="payment-badge">Apple Pay</span>
            <span class="payment-badge">Shop Pay</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Footer Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#c86b85"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Newsletter Options"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Column",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Join for 10% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter Subtext",
      "default": "Subscribe to receive exclusive offers, new product arrivals, and insider updates."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Media Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Heading",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1 Link List",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Heading",
      "default": "Help"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2 Link List"
    },
    {
      "type": "text",
      "id": "menu_3_title",
      "label": "Menu 3 Heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_3",
      "label": "Menu 3 Link List"
    },
    {
      "type": "header",
      "content": "Watermark & Copyright"
    },
    {
      "type": "checkbox",
      "id": "show_watermark",
      "label": "Show Watermark Text",
      "default": true
    },
    {
      "type": "text",
      "id": "watermark_text",
      "label": "Watermark Text",
      "default": "JovarkusSalesCo"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Name",
      "default": "JovarkusSalesCo"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    }
  ]
}
{% endschema %}
