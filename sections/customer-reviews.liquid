<div class="customer-reviews-section" style="background-color: {{ section.settings.bg_color | default: 'var(--color-bg)' }};">
  <div class="page-width">
    
    <!-- Section Header -->
    {% if section.settings.title != blank %}
      <div class="customer-reviews-header">
        <h2 class="customer-reviews-title">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="customer-reviews-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Reviews Grid -->
    {% if section.blocks.size > 0 %}
      <div class="customer-reviews-grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'review' %}
              <div class="customer-review-card" {{ block.shopify_attributes }}>
                <!-- Star Rating -->
                <div class="customer-review-stars">
                  {% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}
                </div>

                <!-- Review Headline -->
                <h3 class="customer-review-heading">{{ block.settings.heading }}</h3>

                <!-- Review Body -->
                <p class="customer-review-text">"{{ block.settings.review_text }}"</p>

                <!-- Author Footer -->
                <div class="customer-review-author-box">
                  <div class="customer-review-avatar">
                    {{ block.settings.author_name | slice: 0 | uppercase | default: 'V' }}
                  </div>
                  <div class="customer-review-author-info">
                    <span class="customer-review-name">{{ block.settings.author_name }}</span>
                    {% if block.settings.verified_buyer %}
                      <span class="customer-review-verified">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 3px;">
                          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                          <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        Verified Buyer
                      </span>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% when '@app' %}
              {% render block %}
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center" style="padding: 40px; background-color: var(--color-card-bg); border-radius: var(--border-radius-card);">
        <p style="color: var(--color-text-muted);">Connect your Shopify Review App or add review blocks in Theme Editor.</p>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Customer Feedback"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subheading",
      "default": "Read real experiences from verified store customers."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Customer Review Card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Review Headline",
          "default": "Outstanding Quality"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Body",
          "default": "The product exceeded my expectations. Shipping was fast and the quality is exceptional."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Verified Customer"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Show Verified Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "heading": "Exceptional Quality",
            "review_text": "The craftsmanship and attention to detail are amazing. Truly exceeded my expectations!",
            "author_name": "Sarah M.",
            "verified_buyer": true
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Fast Delivery & Packaging",
            "review_text": "Arrived within 2 days in beautiful eco-friendly packaging. Will definitely order again.",
            "author_name": "David K.",
            "verified_buyer": true
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Highly Recommended",
            "review_text": "Five stars! Great customer support and superior product build.",
            "author_name": "Elena R.",
            "verified_buyer": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
