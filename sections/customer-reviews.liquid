<div style="padding: 80px 0; background-color: var(--color-bg);">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <div class="text-center" style="margin-bottom: 48px;">
        <h2>{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <p style="color: var(--color-text-muted);">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px;">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'review' %}
              <div style="background-color: var(--color-card-bg); padding: 32px; border-radius: var(--border-radius-card); border: 1px solid var(--color-border);" {{ block.shopify_attributes }}>
                <div class="star-rating" style="margin-bottom: 12px;">
                  {% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}{% render 'icon-star' %}
                </div>
                <h3 style="font-size: 1.1rem; margin-bottom: 8px;">{{ block.settings.heading }}</h3>
                <p style="font-size: 0.92rem; color: var(--color-text-muted); margin-bottom: 20px;">"{{ block.settings.review_text }}"</p>
                <div style="font-weight: 700; font-size: 0.88rem;">{{ block.settings.author_name }}</div>
                {% if block.settings.verified_buyer %}
                  <span style="font-size: 0.75rem; color: var(--color-primary); font-weight: 600;">✔ Verified Customer</span>
                {% endif %}
              </div>
            {% when '@app' %}
              {% render block %}
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center" style="padding: 40px; background-color: var(--color-card-bg); border-radius: var(--border-radius-card);">
        <p style="color: var(--color-text-muted);">Connect your Shopify Review App or add review blocks in Theme Editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Customer Feedback"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subheading",
      "default": "Read real experiences from verified store customers."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Customer Review Card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Review Headline",
          "default": "Outstanding Quality"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Body",
          "default": "The product exceeded my expectations. Shipping was fast and the quality is exceptional."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Verified Customer"
        },
        {
          "type": "checkbox",
          "id": "verified_buyer",
          "label": "Show Verified Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "heading": "Exceptional Quality",
            "review_text": "The craftsmanship and attention to detail are amazing. Truly exceeded my expectations!",
            "author_name": "Sarah M.",
            "verified_buyer": true
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Fast Delivery & Packaging",
            "review_text": "Arrived within 2 days in beautiful eco-friendly packaging. Will definitely order again.",
            "author_name": "David K.",
            "verified_buyer": true
          }
        },
        {
          "type": "review",
          "settings": {
            "heading": "Highly Recommended",
            "review_text": "Five stars! Great customer support and superior product build.",
            "author_name": "Elena R.",
            "verified_buyer": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
